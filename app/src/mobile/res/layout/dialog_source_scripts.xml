<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/dialogSurface"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/script_source_title"
        android:textColor="?attr/dialogTextPrimary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/et_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="?attr/dialogInputSurface"
        android:hint="@string/script_source_search"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:singleLine="true"
        android:textColor="?attr/dialogTextPrimary"
        android:textColorHint="?attr/dialogTextHint"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/layout_columns"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/column_py"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/script_source_py"
                android:textColor="?attr/dialogTextSecondary"
                android:textSize="12sp" />

            <com.fongmi.android.tv.ui.custom.CustomRecyclerView
                android:id="@+id/rv_py"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:maxHeight="300dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/column_js"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/script_source_js"
                android:textColor="?attr/dialogTextSecondary"
                android:textSize="12sp" />

            <com.fongmi.android.tv.ui.custom.CustomRecyclerView
                android:id="@+id/rv_js"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:maxHeight="300dp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:padding="24dp"
        android:text="@string/script_source_empty"
        android:textColor="?attr/dialogTextSecondary"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
