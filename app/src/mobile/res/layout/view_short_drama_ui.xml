<?xml version="1.0" encoding="utf-8"?>
<!--
  短剧专用播放 UI（竖屏全屏，抖音短剧式）：
  满屏视频 + 右列功能栏 + 底部剧名/集数胶囊/细进度条；上下滑时露出相邻集封面与集名。
  无返回钮（退出靠系统返回/手势），只由 VideoActivity 在 short_drama 模式挂到 video 容器；
  进入画中画时整层隐藏，避免 PiP 下按钮/文字被放大。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sdRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="false"
    android:focusable="false">

    <!-- 相邻集预览：拖动时从上下露出来 -->
    <ImageView
        android:id="@+id/sdPreviewPrev"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="上一集预览"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/sdPreviewNext"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="下一集预览"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <TextView
        android:id="@+id/sdPreviewPrevLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/sd_chip_bg"
        android:gravity="center"
        android:maxLines="1"
        android:paddingHorizontal="16dp"
        android:paddingVertical="7dp"
        android:shadowColor="#99000000"
        android:shadowDy="1"
        android:shadowRadius="6"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/sdPreviewNextLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/sd_chip_bg"
        android:gravity="center"
        android:maxLines="1"
        android:paddingHorizontal="16dp"
        android:paddingVertical="7dp"
        android:shadowColor="#99000000"
        android:shadowDy="1"
        android:shadowRadius="6"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- 右侧功能栏（抖音短剧式：选集/倍速/追剧/分享/锁定） -->
    <LinearLayout
        android:id="@+id/sdRail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="12dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/sdEpisodes"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/sd_circle_bg"
            android:gravity="center"
            android:shadowColor="#99000000"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:text="选集"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sdSpeed"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/sd_circle_bg"
            android:gravity="center"
            android:shadowColor="#99000000"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:text="1.0x"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/sdKeep"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/sd_circle_bg"
            android:contentDescription="追剧"
            android:padding="15dp"
            android:src="@drawable/ic_control_keep_off" />

        <TextView
            android:id="@+id/sdShare"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/sd_circle_bg"
            android:gravity="center"
            android:shadowColor="#99000000"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:text="分享"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/sdLock"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/sd_circle_bg"
            android:contentDescription="锁定"
            android:padding="15dp"
            android:src="@drawable/ic_control_lock_off" />
    </LinearLayout>

    <!-- 底部信息区：剧名 / 集数胶囊 / 细进度条 -->
    <LinearLayout
        android:id="@+id/sdBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/sd_bottom_scrim"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="56dp"
        android:paddingEnd="18dp"
        android:paddingBottom="18dp">
        <TextView
            android:id="@+id/sdTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="#99000000"
            android:shadowDy="1"
            android:shadowRadius="8"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/sdEpisode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/sd_chip_bg"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:textColor="#F2FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
        <ProgressBar
            android:id="@+id/sdProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="14dp"
            android:max="1000"
            android:progress="0"
            android:progressDrawable="@drawable/sd_progress" />
    </LinearLayout>

    <!-- 播放/暂停提示（点按闪一下） -->
    <TextView
        android:id="@+id/sdPlayHint"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_gravity="center"
        android:alpha="0"
        android:background="@drawable/sd_circle_bg"
        android:gravity="center"
        android:shadowColor="#99000000"
        android:shadowDy="1"
        android:shadowRadius="6"
        android:text="❚❚"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />
</FrameLayout>
