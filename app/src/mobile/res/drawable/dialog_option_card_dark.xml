<?xml version="1.0" encoding="utf-8"?>
<!-- 深色风格选项卡/条目卡：始终显示描边（常态淡 accent 描边，按下 accent 描边） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/dialogSurfaceColor" />
            <stroke android:width="1.5dp" android:color="?attr/dialogAccent" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/dialogSurfaceColor" />
            <stroke android:width="1.5dp" android:color="?attr/dialogAccent" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <!-- 常态：始终可见的描边，比 dialogDivider 更亮一档，但比 accent 弱 -->
        <shape android:shape="rectangle">
            <solid android:color="?attr/dialogSurfaceColor" />
            <stroke android:width="1dp" android:color="?attr/dialogTextHint" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
