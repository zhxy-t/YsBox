<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="ScopedStorage">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <queries>
        <intent>
            <action android:name="android.settings.MANAGE_APP_ALL_FILES_ACCESS_PERMISSION" />
            <data android:scheme="package" />
        </intent>
        <intent>
            <action android:name="android.settings.MANAGE_ALL_FILES_ACCESS_PERMISSION" />
        </intent>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="video/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <supports-screens
        android:anyDensity="true"
        android:resizeable="true"
        android:smallScreens="true"
        android:normalScreens="true"
        android:largeScreens="true"
        android:xlargeScreens="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".App"
        android:banner="@mipmap/ic_banner"
        android:allowBackup="false"
        android:appCategory="video"
        android:enableOnBackInvokedCallback="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:pageSizeCompat="enabled"
        android:requestLegacyExternalStorage="true"
        android:resizeableActivity="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.App"
        android:usesCleartextTraffic="true"
        tools:replace="android:allowBackup">
        <!-- 单 Launcher 入口：按 UiMode 运行时分发到手机 / 电视首页 -->
        <activity
            android:name=".ui.activity.LauncherActivity"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.activity.PlaybackRecoveryActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:process=":playback_recovery"
            android:taskAffinity="${applicationId}.playback_recovery"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <activity
            android:screenOrientation="behind"
            android:name=".ui.activity.CrashActivity"
            android:process=":error_activity"
            android:theme="@style/Theme.Crash" />

        <receiver
            android:name=".receiver.ActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="${applicationId}.stop" />
                <action android:name="${applicationId}.prev" />
                <action android:name="${applicationId}.next" />
                <action android:name="${applicationId}.play" />
                <action android:name="${applicationId}.pause" />
                <action android:name="${applicationId}.audio" />
            </intent-filter>
        </receiver>

        <service
            android:name=".service.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="com.fongmi.android.tv.Startup"
                android:value="androidx.startup" />
        </provider>

        <!-- ===== mobile 组件 ===== -->
        <activity
            android:name=".ui.activity.HomeActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Splash"
            android:windowSoftInputMode="adjustPan">

            <meta-data
                android:name="android.app.searchable"
                android:resource="@xml/searchable" />


            <intent-filter>
                <action android:name="android.intent.action.SEARCH" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/x-bittorrent" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="smb" />
                <data android:scheme="rtmp" />
                <data android:scheme="rtsp" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="ed2k" />
                <data android:scheme="magnet" />
                <data android:scheme="thunder" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.activity.SearchActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout"
            android:windowSoftInputMode="adjustPan" />

        <activity
            android:name=".ui.activity.FileActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout" />

        <activity
            android:name=".ui.activity.FolderActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout" />

        <activity
            android:name=".ui.activity.HistoryActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout" />

        <activity
            android:name=".ui.activity.KeepActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout" />

        <activity
            android:name=".ui.activity.LiveActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|uiMode|orientation"
            android:exported="true"
            android:launchMode="singleTop"
            android:parentActivityName=".ui.activity.HomeActivity"
            android:supportsPictureInPicture="true" />

        <activity
            android:name=".ui.activity.ScanActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout" />

        <activity
            android:name=".ui.activity.VideoActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|uiMode|orientation"
            android:launchMode="singleTop"
            android:parentActivityName=".ui.activity.HomeActivity"
            android:supportsPictureInPicture="true" />

        <activity
            android:name=".ui.activity.PluginActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout"
            android:screenOrientation="behind" />

        <activity
            android:name=".ui.activity.DownloadActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout"
            android:screenOrientation="behind" />

        <!-- 实验室：独立包 ui.lab -->
        <activity
            android:name=".ui.lab.LabHomeActivity"
            android:theme="@style/Theme.Lab"
            android:configChanges="screenSize|smallestScreenSize|screenLayout"
            android:screenOrientation="behind" />
        <activity
            android:name=".ui.lab.LabSettingActivity"
            android:theme="@style/Theme.Lab"
            android:configChanges="screenSize|smallestScreenSize|screenLayout"
            android:screenOrientation="behind" />
        <activity
            android:name=".ui.lab.LabEnvActivity"
            android:theme="@style/Theme.Lab"
            android:configChanges="screenSize|smallestScreenSize|screenLayout"
            android:screenOrientation="behind" />
        <activity
            android:name=".ui.lab.LabServiceActivity"
            android:theme="@style/Theme.Lab"
            android:configChanges="screenSize|smallestScreenSize|screenLayout"
            android:screenOrientation="behind" />
        <activity
            android:name=".ui.lab.LabLogActivity"
            android:theme="@style/Theme.Lab"
            android:configChanges="screenSize|smallestScreenSize|screenLayout"
            android:screenOrientation="behind" />
        <activity
            android:name=".ui.lab.LabPasteImportActivity"
            android:theme="@style/Theme.Lab"
            android:configChanges="screenSize|smallestScreenSize|screenLayout"
            android:screenOrientation="behind" />
        <activity
            android:name=".ui.lab.LabInstallActivity"
            android:exported="true"
            android:theme="@style/Theme.Lab"
            android:configChanges="screenSize|smallestScreenSize|screenLayout"
            android:screenOrientation="behind">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.lab" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.lab.LabLiveOutputActivity"
            android:theme="@style/Theme.Lab"
            android:configChanges="screenSize|smallestScreenSize|screenLayout"
            android:screenOrientation="behind" />
        <activity
            android:name=".ui.lab.LabTerminalActivity"
            android:theme="@style/Theme.Lab"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden"
            android:screenOrientation="behind"
            android:windowSoftInputMode="adjustResize" />

        <service
            android:name=".ui.lab.LabKeepAlive"
            android:exported="false" />

        <!-- 旧实验室：播放器实验开关页，从实验室设置进入 -->
        <activity
            android:name=".ui.activity.LabActivity"
            android:screenOrientation="behind"
            android:configChanges="screenSize|smallestScreenSize|screenLayout" />

        <activity
            android:name=".ui.activity.EnhancedActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout"
            android:screenOrientation="behind" />

        <activity
            android:name=".ui.activity.PanDriveLoginActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout"
            android:screenOrientation="behind" />

        <activity
            android:name=".ui.activity.PanLoginActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout"
            android:screenOrientation="behind" />

        <activity
            android:name=".ui.activity.MiniAppActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout" />

        <activity
            android:name=".ui.hk.HkListActivity"
            android:exported="false"
            android:theme="@style/Theme.XingChen.HkPage"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="behind" />

        <activity
            android:name=".ui.hk.HkSearchActivity"
            android:exported="false"
            android:theme="@style/Theme.XingChen.HkPage"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:screenOrientation="behind"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.activity.HkPageActivity"
            android:exported="true"
            android:theme="@style/Theme.XingChen.HkPage"
            android:configChanges="screenSize|smallestScreenSize|screenLayout"
            android:screenOrientation="behind">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\.json" />
                <data android:pathPattern=".*\.hkzip" />
                <data android:pathPattern=".*\.zip" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.activity.HkRuleSearchActivity"
            android:theme="@style/Theme.XingChen.HkPage"
            android:configChanges="screenSize|smallestScreenSize|screenLayout"
            android:screenOrientation="behind" />

        <activity
            android:name=".ui.activity.HkFavoriteActivity"
            android:theme="@style/Theme.XingChen.HkPage"
            android:configChanges="screenSize|smallestScreenSize|screenLayout"
            android:screenOrientation="behind" />

        <activity
            android:name=".ui.activity.HkHistoryActivity"
            android:theme="@style/Theme.XingChen.HkPage"
            android:configChanges="screenSize|smallestScreenSize|screenLayout"
            android:screenOrientation="behind" />

        <activity
            android:name=".ui.activity.AdBlockActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout"
            android:screenOrientation="behind" />

        <activity
            android:name=".ui.activity.AiSettingsActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout"
            android:screenOrientation="behind" />

        <activity
            android:name=".ui.activity.AiProviderEditActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.activity.AiAsrSettingsActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout" />

        <activity
            android:name=".ui.activity.TmdbActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout"
            android:screenOrientation="behind" />

        <activity
            android:name=".ui.activity.PythonPackagesActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout" />

        <receiver
            android:name=".receiver.ShortcutReceiver"
            android:exported="false" />

        <service
            android:name=".service.DLNACastService"
            android:exported="false" />

    

        <!-- ===== leanback 组件 ===== -->

        <activity
            android:name=".ui.leanback.activity.HomeActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.Tv.Splash">

            <meta-data
                android:name="android.app.searchable"
                android:resource="@xml/searchable" />


            <intent-filter>
                <action android:name="android.intent.action.SEARCH" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/x-bittorrent" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="smb" />
                <data android:scheme="rtmp" />
                <data android:scheme="rtsp" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="ed2k" />
                <data android:scheme="magnet" />
                <data android:scheme="thunder" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.leanback.activity.CastActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|uiMode|orientation"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="${applicationId}.cast" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.leanback.activity.VodActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".ui.leanback.activity.LiveActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|uiMode|orientation"
            android:exported="true"
            android:launchMode="singleTop"
            android:parentActivityName=".ui.activity.HomeActivity"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".ui.leanback.activity.VideoActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|uiMode|orientation|keyboard|keyboardHidden|navigation"
            android:launchMode="singleTop"
            android:parentActivityName=".ui.activity.HomeActivity"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".ui.leanback.activity.KeepActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".ui.leanback.activity.PushActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".ui.leanback.activity.SearchActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="stateHidden" />

        <activity
            android:name=".ui.leanback.activity.CollectActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".ui.leanback.activity.FileActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".ui.leanback.activity.SettingActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".ui.leanback.activity.SettingPlayerActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".ui.leanback.activity.SettingDecodeActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".ui.leanback.activity.SettingPreloadActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".ui.leanback.activity.SettingDanmakuActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".ui.leanback.activity.SettingSubtitleActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".ui.leanback.activity.SettingAppearanceActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".ui.leanback.activity.SettingPersonalActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:screenOrientation="sensorLandscape" />

        <service
            android:name=".service.DLNARendererService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true"
            android:priority="999">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    
</application>
</manifest>
