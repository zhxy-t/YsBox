    <style name="Theme.App" parent="Theme.Base" />

    <!-- ========== 5种弹窗风格的App主题变体 ==========
         警告：这些 style 会被 BaseActivity.applyDialogTheme() 通过 setTheme() 用作【整个 Activity 主题】。
         因此这里【只能】放弹窗专用 attr（alertDialogTheme / materialAlertDialogTheme / dialogXxx 自定义语义色）。
         严禁写入 colorSurface / colorPrimary / android:textColorSecondary 等系统级 M3 attr 的裸色值(#RRGGBB)：
         裸色的 TypedValue.resourceId=0，Material 组件(如 BottomNavigationView)构造时
         Resources.getValue(0) 会抛 "Resource ID #0x0" 导致冷启动崩溃。
         系统级配色一律放在下面的 ThemeOverlay.* 里（overlay 只作用于弹窗 Context，不污染 Activity）。 -->
    <style name="Theme.App.DialogClassic" parent="Theme.App">
        <item name="alertDialogTheme">@style/ThemeOverlay.XingChen.GlassDialog.Dark</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.XingChen.GlassDialog.Dark</item>

        <!-- 主题级语义色：保证 ?attr 在任何 inflate 场景可解析，且 Material 弹窗不再用默认白底 -->
        <item name="dialogSurface">@drawable/dialog_glass_dark</item>
        <item name="dialogSurfaceColor">#1A1D24</item>
        <item name="dialogTextPrimary">#F2F4F8</item>
        <item name="dialogTextSecondary">#A8B0C0</item>
        <item name="dialogTextHint">#7A8290</item>
        <item name="dialogAccent">#D9A420</item>
        <item name="dialogInputSurface">@drawable/bg_dialog_input_neon</item>
        <item name="dialogDivider">#33FFFFFF</item>
        <item name="dialogCardSurface">@drawable/dialog_option_card_dark</item>
        <item name="textColorAlertDialogListItem">?attr/dialogTextPrimary</item>
</style>

    <style name="Theme.App.DialogWhite" parent="Theme.App">
