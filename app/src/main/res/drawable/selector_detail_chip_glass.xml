<?xml version="1.0" encoding="utf-8"?>
<!-- 白色磨砂玻璃胶囊：彩色/深色背景上都不发黑 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#B3FFFFFF" />
            <stroke android:width="1.5dp" android:color="?attr/colorPrimary" />
            <corners android:radius="@dimen/chip_glass_radius_16" />
            <padding android:left="14dp" android:top="8dp" android:right="14dp" android:bottom="8dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#B3FFFFFF" />
            <stroke android:width="1.5dp" android:color="?attr/colorPrimary" />
            <corners android:radius="@dimen/chip_glass_radius_16" />
            <padding android:left="14dp" android:top="8dp" android:right="14dp" android:bottom="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#40FFFFFF" />
            <stroke android:width="1dp" android:color="#26FFFFFF" />
            <corners android:radius="@dimen/chip_glass_radius_16" />
            <padding android:left="14dp" android:top="8dp" android:right="14dp" android:bottom="8dp" />
        </shape>
    </item>
</selector>
